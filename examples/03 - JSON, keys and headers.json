        "name": "summary",
        "func": "// msg.payload is an object (Payload: Parsed JSON); key and header\n// values are strings.\nconst order = msg.payload;\nmsg.payload = `customer ${msg.key}: order ${order.orderId}, total ${order.total} ` +\n    `(event ${msg.headers.event}, from ${msg.headers.source}, ` +\n    `partition ${msg.partition}, offset ${msg.offset})`;\nreturn msg;\n",
