    {
        "id": "d02fa52424cf490f",
        "type": "function",
        "z": "6e6b107ac4a184c5",
        "name": "process the message",
        "func": "// Do the real work here: write to a database, call an API...\n// Pass the message on only when the work succeeded: it is then\n// committed. Return null (or throw) when it failed: the message\n// is not committed and Kafka delivers it again after a restart.\n// Keep msg.kafka: the commit needs its topic, partition and offset.\nnode.status({ fill: 'green', shape: 'dot', text: `processed offset ${msg.offset}` });\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 270,
        "wires": [
            [
